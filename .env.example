# Copy this file to .env for Docker Compose. Never commit .env.
POSTGRES_DB=cropleaf
POSTGRES_USER=cropleaf
POSTGRES_PASSWORD=change-this-to-a-long-random-password
SECRET_KEY=replace-with-a-django-secret-key
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
# Leave blank for the standard stack; set to http://jaeger:4318 when using
# docker compose --profile observability up.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: provide HTTPS URLs or Drive IDs for the two ML model files.
# The application still starts without models, but prediction needs at least one.
TF_MODEL_URL=
PT_MODEL_URL=
TF_MODEL_GOOGLE_DRIVE_ID=
PT_MODEL_GOOGLE_DRIVE_ID=
